# MCC-side image for the VoltAgent governed-integration stack: the gateway, the
# receipt-verifying governed executor, the mock notification service, the evaluator
# quorum, and the one-shot config generator. Build context is the repository root.
FROM python:3.11-slim

RUN useradd --create-home --uid 10007 mcc
WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Authoritative runtime + gateway + governed executor + mock service + the
# VoltAgent MCC-side roles (evaluator quorum + config generator).
COPY src /app/src
COPY gateway /app/gateway
COPY examples /app/examples
COPY pilot_notify /app/pilot_notify
COPY integrations/voltagent/mcc_side /app/integrations/voltagent/mcc_side

ENV PYTHONPATH=/app/src:/app

# Least-privilege sharing of /pilot-state (the ESCALATE pending-approval file):
# a fixed shared group (GID 10990) that both the gateway (mcc) and the agent
# (node, in the agent image) join. The gateway starts first and initialises the
# volume as mcc:mcc-shared, mode 2770 (group rwx + setgid so files created by the
# agent inherit the shared group; NO access for unrelated users).
RUN groupadd -g 10990 mcc-shared \
    && usermod -aG mcc-shared mcc \
    && mkdir -p /config /data /pilot-state \
    && chown -R mcc:mcc /config /data /app \
    && chown mcc:mcc-shared /pilot-state \
    && chmod 2770 /pilot-state
USER mcc

CMD ["python", "-c", "print('mcc voltagent image')"]

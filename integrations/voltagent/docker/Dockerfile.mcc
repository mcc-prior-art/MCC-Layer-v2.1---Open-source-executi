# MCC-side image for the VoltAgent governed-integration stack: the gateway, the
# receipt-verifying governed executor, the mock notification service, the evaluator
# quorum, and the one-shot config generator. Build context is the repository root.
FROM python:3.11-slim

RUN useradd --create-home --uid 10007 mcc
WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Authoritative runtime + gateway + governed executor + mock service + the
# VoltAgent MCC-side roles (evaluator quorum + config generator).
COPY src /app/src
COPY gateway /app/gateway
COPY examples /app/examples
COPY pilot_notify /app/pilot_notify
COPY integrations/voltagent/mcc_side /app/integrations/voltagent/mcc_side

ENV PYTHONPATH=/app/src:/app

# The shared config volume must be writable by the mcc user (evaluator keyset).
RUN mkdir -p /config /data && chown -R mcc:mcc /config /data /app
USER mcc

CMD ["python", "-c", "print('mcc voltagent image')"]

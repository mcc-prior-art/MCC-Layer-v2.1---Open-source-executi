# Reference pilot integration configuration (PR #82).
#
# Copy this file to `.env.pilot-readiness` (git-ignored -- see .gitignore)
# and fill in real values for your environment. DO NOT commit
# `.env.pilot-readiness` or any file containing a real API key.
#
# This file contains ONLY safe placeholder values. It names no real
# partner, endpoint, or production system.

# The MCC-Core Gateway this pilot connects to. Point this at a Gateway you
# control or have been given access to -- see docs/PILOT_RUNBOOK.md.
MCC_PILOT_GATEWAY_URL=http://127.0.0.1:8001

# Per-request timeout, in seconds, applied to every POST /evaluate call.
MCC_PILOT_TIMEOUT_SECONDS=10.0

# "observe" (default, safe) never actuates the simulated actuator, no
# matter what the Gateway decides. "enforced" allows ALLOW/CONSTRAIN
# decisions to reach the local SimulatedActuator only -- see
# docs/PILOT_RUNBOOK.md's enforced-mode procedure before changing this.
MCC_PILOT_MODE=observe

# A short, stable identifier for this pilot engagement. Do not put a real
# partner or company name in a value tracked anywhere in this repository.
MCC_PILOT_ID=change-me-pilot-id

# Identifies this specific reference integration build/version in evidence.
MCC_PILOT_INTEGRATION_ID=reference-python-v1

# Where pilot evidence bundles are written. The default is already
# git-ignored (see the root-anchored /artifacts/ entry in .gitignore).
MCC_PILOT_EVIDENCE_DIR=./artifacts/pilot-evidence

# Optional: pin the run's correlation identifier (e.g. to match an external
# ticket or run id). If unset, a random one is generated per run.
# MCC_PILOT_RUN_CORRELATION_ID=change-me-run-correlation-id

# Optional: the Gateway's X-API-Key, if the deployment requires one. Leave
# unset for a Gateway running with its open dev default. NEVER commit a
# real key -- set this only in your local, git-ignored .env file or in your
# deployment's secret manager.
# MCC_PILOT_API_KEY=change-me-api-key

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcc-prior-art/schemas/normative-v1.0/coverage_audit.schema.json",
  "title": "MCC Normative v1.0 Extraction Coverage Audit",
  "description": "Reconciliation of every previously-orphaned normative source line (MUST/MUST NOT/SHALL/SHALL NOT/REQUIRED, inside an H1 section already containing a canonical requirement ID) against the corrected extractor's disposition for it. Generated by src/mcc_conformance/coverage_audit.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entry_count", "disposition_totals", "entries"],
  "properties": {
    "schema": { "type": "string", "minLength": 1 },
    "entry_count": { "type": "integer", "minimum": 0 },
    "disposition_totals": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specification_id",
          "category",
          "source_line",
          "normalized_text",
          "disposition",
          "requirement_id",
          "duplicate_of",
          "rationale"
        ],
        "properties": {
          "specification_id": {
            "type": "string",
            "enum": ["MCC-CP-001", "MCC-EB-001", "MCC-CM-001", "MCC-TC-001"]
          },
          "category": { "type": "string" },
          "source_line": { "type": "integer", "minimum": 1 },
          "normalized_text": { "type": "string", "minLength": 1 },
          "disposition": {
            "type": "string",
            "enum": ["EXTRACTED", "DUPLICATE_OF_CANONICAL", "DUPLICATE_WITHIN_DERIVED"]
          },
          "requirement_id": { "type": ["string", "null"] },
          "duplicate_of": { "type": ["string", "null"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

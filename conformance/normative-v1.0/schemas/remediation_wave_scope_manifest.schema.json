{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcc-prior-art/schemas/normative-v1.0/remediation_wave_scope_manifest.schema.json",
  "title": "MCC Normative v1.0 Remediation Wave Scope Manifest",
  "description": "Bounded remediation-wave scope manifest shape shared by every Normative v1.0 implementation wave (Wave A: PR #63, Wave B: PR #64, ...). Authored, not generated; validated structurally by tests/test_wave_a_scope_manifest.py and tests/test_wave_b_scope_manifest.py.",
  "type": "object",
  "required": [
    "wave",
    "objective",
    "selected_requirements",
    "excluded_candidate_ids",
    "global_status_delta",
    "unexpected_transitions_outside_selected_scope",
    "not_implemented_in_this_pr"
  ],
  "properties": {
    "wave": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "selected_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "specification", "normative_obligation", "source_section", "source_span", "status_before"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "specification": {
            "type": "string",
            "enum": ["MCC-CP-001", "MCC-EB-001", "MCC-CM-001", "MCC-TC-001"]
          },
          "normative_obligation": { "type": "string", "minLength": 1 },
          "source_section": { "type": "string", "minLength": 1 },
          "source_span": { "type": "string", "minLength": 1 },
          "status_before": { "type": "string", "enum": ["CONFORMANT", "PARTIAL", "GAP", "NOT_APPLICABLE", "NOT_ASSESSED"] },
          "status_after": { "type": "string", "enum": ["CONFORMANT", "PARTIAL", "GAP", "NOT_APPLICABLE", "NOT_ASSESSED"] },
          "excluded": { "type": "boolean" },
          "exclusion_reason": { "type": "string" }
        }
      }
    },
    "excluded_candidate_ids": { "type": "array", "items": { "type": "string" } },
    "global_status_delta": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "object" },
        "after": { "type": "object" }
      }
    },
    "unexpected_transitions_outside_selected_scope": { "type": "array" },
    "not_implemented_in_this_pr": { "type": "array", "items": { "type": "string" } }
  }
}
